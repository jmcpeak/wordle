{
  "name": "wordle-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome lint ./app",
    "typecheck": "tsc --noEmit",
    "lint:fix": "biome lint --write --unsafe ./app",
    "format": "biome format --write ./app",
    "test": "vitest",
    "wordlist": "node scripts/regenerate-wordlist.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@haptics/react": "2.1.1",
    "@mui/icons-material": "9.2.0",
    "@mui/material": "9.2.0",
    "@mui/material-nextjs": "9.1.1",
    "@neondatabase/serverless": "1.1.0",
    "@serwist/next": "9.5.12",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "husky": "9.1.7",
    "jsdom": "30.0.0",
    "lint-staged": "17.2.0",
    "serwist": "9.5.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write"
    ],
    "*.{json,css}": [
      "biome format --write"
    ]
  },
  "allowScripts": {
    "fsevents": true,
    "sharp": true
  }
}
